doctype html
html(lang="zh-CN")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="description" content="EmbedAI - 嵌入式技术与 AI 应用分享")
    title EmbedAI — 嵌入式 × AI 技术笔记
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=DM+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap")
    link(rel="stylesheet" href="/css/site.css")
    style.
      :root {
        --bg: #faf9f6;
        --bg-soft: #f3f1ec;
        --bg-elev: #ffffff;
        --border: rgba(26,26,31,0.08);
        --border-strong: rgba(26,26,31,0.14);
        --text: #1a1a1f;
        --text-2: rgba(26,26,31,0.7);
        --text-3: rgba(26,26,31,0.48);
        --accent: #6b9e83;
        --accent-soft: #d8e6dd;
        --accent-glow: rgba(107,158,131,0.18);
        --warm: #e8a87c;
        --warm-soft: #f7e3d0;
        --peach: #f4c6a8;
        --sky: #a8c8e0;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { background: var(--bg); color: var(--text); }
      body {
        font-family: 'DM Sans', 'PingFang SC', 'Microsoft YaHei', sans-serif;
        line-height: 1.65;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        position: relative;
        overflow-x: hidden;
      }
      /* 柔和渐变背景 */
      body::before {
        content: '';
        position: fixed; inset: 0;
        background:
          radial-gradient(ellipse 60% 50% at 80% 0%, var(--peach) 0%, transparent 60%),
          radial-gradient(ellipse 50% 40% at 0% 30%, var(--sky) 0%, transparent 60%),
          radial-gradient(ellipse 50% 40% at 100% 80%, var(--accent-soft) 0%, transparent 60%);
        opacity: 0.35;
        pointer-events: none;
        z-index: 0;
      }
      .container {
        position: relative;
        z-index: 1;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      /* 顶部状态栏 */
      .topbar {
        border-bottom: 1px solid var(--border);
        padding: 0.9rem 0;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: var(--text-3);
      }
      .topbar-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
      }
      .status-dot {
        display: inline-block;
        width: 8px; height: 8px;
        background: var(--accent);
        border-radius: 50%;
        margin-right: 0.5rem;
        box-shadow: 0 0 0 4px var(--accent-glow);
        animation: pulse 2.5s ease-in-out infinite;
        vertical-align: middle;
      }
      @keyframes pulse {
        0%, 100% { box-shadow: 0 0 0 4px var(--accent-glow); }
        50% { box-shadow: 0 0 0 8px transparent; }
      }
      .topbar a { color: var(--text-2); text-decoration: none; transition: color 0.2s; }
      .topbar a:hover { color: var(--accent); }
      .topbar-links { display: flex; gap: 1.5rem; }

      /* Hero */
      .hero {
        padding: 6rem 0 4rem;
        position: relative;
      }
      .hero-meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        color: var(--text-3);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .hero-meta .tag {
        background: var(--bg-elev);
        border: 1px solid var(--border);
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        color: var(--text-2);
        font-size: 0.72rem;
      }
      .hero-meta .tag.accent {
        background: var(--accent-soft);
        border-color: transparent;
        color: var(--accent);
      }
      .hero h1 {
        font-family: 'Plus Jakarta Sans', 'PingFang SC', sans-serif;
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -0.03em;
        margin-bottom: 1.5rem;
        color: var(--text);
      }
      .hero h1 .accent {
        background: linear-gradient(135deg, var(--accent), var(--warm));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        position: relative;
      }
      .hero h1 .cursor {
        display: inline-block;
        width: 0.4em;
        height: 0.75em;
        background: var(--accent);
        border-radius: 2px;
        vertical-align: -0.05em;
        margin-left: 0.08em;
        animation: blink 1.1s steps(1) infinite;
      }
      @keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
      }
      .hero-sub {
        font-size: 1.1rem;
        color: var(--text-2);
        max-width: 600px;
        margin-bottom: 2.5rem;
      }
      .hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.92rem;
        color: #ffffff;
        background: var(--text);
        padding: 0.85rem 1.6rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 500;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 14px rgba(26,26,31,0.12);
      }
      .hero-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(26,26,31,0.18);
      }
      .hero-cta .arrow { transition: transform 0.2s; }
      .hero-cta:hover .arrow { transform: translateX(3px); }

      /* 数据条 - 卡片化 */
      .stats {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 1rem;
        margin: 2.5rem 0 5rem;
      }
      .stat {
        background: var(--bg-elev);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 1.5rem 1.5rem;
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .stat:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(26,26,31,0.06);
      }
      .stat .label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: var(--text-3);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.6rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }
      .stat .label::before {
        content: '';
        width: 6px; height: 6px;
        border-radius: 50%;
        background: var(--accent);
      }
      .stat:nth-child(2) .label::before { background: var(--warm); }
      .stat:nth-child(3) .label::before { background: var(--sky); }
      .stat:nth-child(4) .label::before { background: var(--peach); }
      .stat .value {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 2.25rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.02em;
        color: var(--text);
      }
      .stat .value .small {
        font-size: 1rem;
        color: var(--text-3);
        font-weight: 500;
        margin-left: 0.2rem;
      }
      .stat .meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: var(--text-3);
        margin-top: 0.5rem;
      }

      /* 区块 */
      .section { margin-bottom: 5rem; }
      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px dashed var(--border);
      }
      .section-head h2 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .section-head .index {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        color: var(--text-3);
      }

      /* 最新文章 - 不对称布局 */
      .posts {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 1.25rem;
      }
      .post-card {
        background: var(--bg-elev);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 1.75rem;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
        position: relative;
        overflow: hidden;
      }
      .post-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(26,26,31,0.08);
        border-color: var(--border-strong);
      }
      .post-card .date {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: var(--text-3);
      }
      .post-card .badge {
        display: inline-block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        background: var(--accent-soft);
        color: #4a7a64;
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        width: fit-content;
        font-weight: 500;
      }
      .post-card .badge.warm {
        background: var(--warm-soft);
        color: #a86a3c;
      }
      .post-card h3 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.15rem;
        font-weight: 600;
        line-height: 1.35;
        letter-spacing: -0.01em;
      }
      .post-card.featured {
        grid-row: span 2;
        padding: 2rem;
        background: linear-gradient(135deg, var(--bg-elev) 0%, var(--bg-soft) 100%);
      }
      .post-card.featured h3 {
        font-size: 1.6rem;
        line-height: 1.25;
      }
      .post-card .excerpt {
        color: var(--text-2);
        font-size: 0.92rem;
        line-height: 1.65;
      }
      .post-card .read-more {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: var(--text-3);
        margin-top: auto;
        padding-top: 0.5rem;
        transition: color 0.2s;
      }
      .post-card:hover .read-more { color: var(--accent); }

      /* 分类卡 */
      .categories {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1rem;
      }
      .cat {
        background: var(--bg-elev);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 1.5rem;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        min-height: 200px;
        transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
        position: relative;
        overflow: hidden;
      }
      .cat::after {
        content: '';
        position: absolute;
        top: 0; right: 0;
        width: 80px; height: 80px;
        background: radial-gradient(circle at top right, var(--cat-color, var(--accent-soft)) 0%, transparent 70%);
        opacity: 0.4;
        pointer-events: none;
      }
      .cat:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(26,26,31,0.08);
        border-color: var(--border-strong);
      }
      .cat:hover .cat-arrow { color: var(--accent); transform: translate(2px, -2px); }
      .cat-arrow {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        font-family: 'JetBrains Mono', monospace;
        color: var(--text-3);
        transition: color 0.2s, transform 0.2s;
        z-index: 1;
      }
      .cat-num {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: var(--text-3);
        z-index: 1;
      }
      .cat-icon {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--cat-color, var(--accent));
        line-height: 1;
        margin: 0.25rem 0 0.5rem;
        z-index: 1;
      }
      .cat h3 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.05rem;
        font-weight: 600;
        line-height: 1.3;
        z-index: 1;
      }
      .cat-desc {
        font-size: 0.82rem;
        color: var(--text-3);
        line-height: 1.5;
        z-index: 1;
      }
      .cat-foot {
        margin-top: auto;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: var(--text-3);
        padding-top: 0.75rem;
        border-top: 1px dashed var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 1;
      }
      .cat-foot .live { color: var(--accent); }
      .cat-foot .soon { color: var(--warm); }
      .cat-foot .live::before { content: '● '; }
      .cat-foot .soon::before { content: '○ '; }

      /* 关于 */
      .about {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-top: 0;
      }
      .about-card {
        background: var(--bg-elev);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 2.5rem;
        transition: box-shadow 0.2s;
      }
      .about-card:hover {
        box-shadow: 0 12px 30px rgba(26,26,31,0.06);
      }
      .about-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: var(--text-3);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 1.5rem;
      }
      .about-card p {
        color: var(--text-2);
        font-size: 1rem;
        line-height: 1.7;
        margin-bottom: 1rem;
      }
      .about-card p strong { color: var(--text); font-weight: 600; }
      .about-actions { display: flex; flex-direction: column; gap: 0.65rem; margin-top: 2rem; }
      .about-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.9rem 1.2rem;
        background: var(--bg-soft);
        border: 1px solid transparent;
        border-radius: 14px;
        color: var(--text);
        text-decoration: none;
        font-size: 0.9rem;
        transition: background 0.2s, transform 0.2s;
      }
      .about-btn:hover { background: var(--accent-soft); transform: translateX(2px); }
      .about-btn .arrow { font-family: 'JetBrains Mono', monospace; color: var(--text-3); }
      .about-btn:hover .arrow { color: var(--accent); }
      .about-stack {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        line-height: 1.9;
      }
      .about-stack .row {
        display: flex;
        gap: 1rem;
        padding: 0.5rem 0;
        border-bottom: 1px dashed var(--border);
        align-items: center;
      }
      .about-stack .row:last-child { border-bottom: none; }
      .about-stack .key { color: var(--text-3); min-width: 90px; font-size: 0.78rem; }
      .about-stack .val { color: var(--text); font-weight: 500; }
      .about-stack .pill {
        display: inline-block;
        font-size: 0.65rem;
        background: var(--accent-soft);
        color: #4a7a64;
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        margin-left: 0.4rem;
        font-weight: 500;
      }

      /* 底部 */
      .footer {
        padding: 2.5rem 0;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: var(--text-3);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        border-top: 1px dashed var(--border);
        margin-top: 3rem;
      }
      .footer .build { display: flex; gap: 1.5rem; }

      /* 响应式 */
      @media (max-width: 900px) {
        .stats { grid-template-columns: 1fr 1fr; }
        .posts { grid-template-columns: 1fr; }
        .post-card.featured { grid-row: auto; }
        .categories { grid-template-columns: repeat(2, 1fr); }
        .about { grid-template-columns: 1fr; }
        .hero { padding: 4rem 0 3rem; }
        .hero h1 { font-size: clamp(2.25rem, 8vw, 3.5rem); }
      }
      @media (max-width: 480px) {
        html, body { overflow-x: hidden; }
        .container { padding: 0 1.25rem; }
        .stats { grid-template-columns: 1fr 1fr; gap: 0.75rem; }
        .categories { grid-template-columns: 1fr; }
        .stat { padding: 1.1rem; }
        .stat .value { font-size: 1.6rem; }
        .topbar-inner { font-size: 0.65rem; gap: 0.5rem; }
        .topbar-links { gap: 0.75rem; }
        .hero { padding: 3rem 0 2rem; }
        .hero h1 { font-size: 2rem; }
        .hero-sub { font-size: 0.95rem; }
        .post-card, .post-card.featured { padding: 1.25rem; border-radius: 16px; }
        .post-card.featured h3 { font-size: 1.25rem; }
        .about-card { padding: 1.5rem; border-radius: 18px; }
        .about-btn { padding: 0.8rem 1rem; font-size: 0.85rem; }
      }
  body
